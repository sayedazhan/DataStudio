# Allowed browser origins for the public frontend. Keep the Netlify origin during cutover/testing.
CORS_ORIGINS=https://azhandatastudio.com,https://www.azhandatastudio.com,https://azhandatastudio.netlify.app

# Lightweight application-level rate limit for POST analysis requests per client.
# Defaults: 120 requests per 600 seconds (10 minutes).
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=600
